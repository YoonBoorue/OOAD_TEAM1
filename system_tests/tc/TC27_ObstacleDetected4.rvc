# TC27 : ObstacleDetected4
# Precondition : NormalMode, motorDirection=FRONT, forward=true
# Action : no obstacle detected
# Expected : direction unchanged, keep moving forward
power
start
expect mode NormalMode
expect motorDirection FRONT
obstacle 0 0
expect mode NormalMode
expect cleaner on
expect motor moving
expect motorForward true
expect motorDirection FRONT
exit
