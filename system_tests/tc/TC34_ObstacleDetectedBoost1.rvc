# TC34 : ObstacleDetectedBoost1
# Related normal-mode case : TC24_ObstacleDetected1
# Precondition : BoostMode, motorDirection=FRONT, forward=true/false
# Action : front obstacle detected, left clear
# Expected : BoostMode 유지, turnLeft, motorDirection → LEFT, forward=true

# Case A: forward=true
power
start
dust
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motorDirection FRONT
obstacle 1 0
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motor moving
expect motorForward true
expect motorDirection LEFT

# Reset
power
power
start
dust
expect mode BoostMode
expect motorDirection FRONT

# Case B: forward=false
obstacle 1 1
obstacle 1 0
expect motorForward false
expect motorDirection FRONT
obstacle 1 0
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motor moving
expect motorForward true
expect motorDirection LEFT
exit
