# TC40 : ObstacleDetectedBoost7
# Related normal-mode case : TC30_ObstacleDetected7
# Precondition : BoostMode, motorDirection=FRONT, forward=true/false
# Action : front+left blocked → turnRight (checkR=true), front clear → moveForward
# Expected : BoostMode 유지, motorDirection=RIGHT, forward=true

# Case A: forward=true
power
start
dust
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motorDirection FRONT
obstacle 1 1
expect motorDirection RIGHT
obstacle 0 0
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motor moving
expect motorForward true
expect motorDirection RIGHT

# Reset
power
power
start
dust
expect mode BoostMode
expect motorDirection FRONT

# Case B: forward=false
obstacle 1 1
obstacle 1 0
expect motorForward false
expect motorDirection FRONT
obstacle 1 1
expect motorDirection RIGHT
obstacle 0 0
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motor moving
expect motorForward true
expect motorDirection RIGHT
exit
