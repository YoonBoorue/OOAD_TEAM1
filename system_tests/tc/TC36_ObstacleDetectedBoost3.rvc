# TC36 : ObstacleDetectedBoost3
# Related normal-mode case : TC26_ObstacleDetected3
# Precondition : BoostMode, motorDirection=FRONT, forward=false
# Action : backward mode, left blocked → turnRight (checkR=true), front clear → moveForward
# Expected : BoostMode 유지, motorDirection=RIGHT, forward=true
power
start
dust
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motorDirection FRONT
obstacle 1 1
obstacle 1 0
expect motorForward false
expect motorDirection FRONT
obstacle 0 1
expect motorDirection RIGHT
obstacle 0 0
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motor moving
expect motorForward true
expect motorDirection RIGHT
exit
