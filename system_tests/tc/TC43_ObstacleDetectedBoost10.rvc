# TC43 : ObstacleDetectedBoost10
# Related normal-mode case : TC33_ObstacleDetected10
# Precondition : BoostMode, motorDirection=FRONT, forward=true/false
# Action : front+left blocked → turnRight (checkR=true), front still blocked → BACK
# Expected : BoostMode 유지, motorDirection=RIGHT (intermediate), then forward=false

# Case A: forward=true
power
start
dust
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motorDirection FRONT
obstacle 1 1
expect motorDirection RIGHT
obstacle 1 0
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motor moving
expect motorForward false

# Reset
power
power
start
dust
expect mode BoostMode
expect motorDirection FRONT

# Case B: forward=false
obstacle 1 1
obstacle 1 0
expect motorForward false
expect motorDirection FRONT
obstacle 0 1
expect motorDirection RIGHT
obstacle 1 0
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motor moving
expect motorForward false
exit
