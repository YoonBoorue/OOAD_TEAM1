# TC29 : ObstacleDetected6
# Precondition : NormalMode, motorDirection=FRONT, forward=true/false
# Action : front obstacle detected, left clear (right sensor removed)
# Expected : turnLeft, motorDirection → LEFT, forward=true

# Case A: forward=true
power
start
expect mode NormalMode
expect motorDirection FRONT
obstacle 1 0
expect mode NormalMode
expect cleaner on
expect motor moving
expect motorForward true
expect motorDirection LEFT

# Reset
power
power
start
expect motorDirection FRONT

# Case B: forward=false
obstacle 1 1
obstacle 1 0
expect motorForward false
expect motorDirection FRONT
obstacle 1 0
expect mode NormalMode
expect cleaner on
expect motor moving
expect motorForward true
expect motorDirection LEFT
exit
