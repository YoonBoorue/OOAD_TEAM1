# TC35 : ObstacleDetectedBoost2
# Related normal-mode case : TC25_ObstacleDetected2
# Precondition : BoostMode, motorDirection=FRONT, forward=true
# Action : left obstacle detected, front clear
# Expected : BoostMode 유지, direction unchanged, keep moving forward
power
start
dust
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motorDirection FRONT
obstacle 0 1
expect mode BoostMode
expect cleaner on
expect cleanerMode boost
expect motor moving
expect motorForward true
expect motorDirection FRONT
exit
