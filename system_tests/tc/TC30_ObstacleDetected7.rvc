# TC30 : ObstacleDetected7
# Precondition : NormalMode, motorDirection=FRONT, forward=true/false
# Action : front+left blocked → turnRight (checkR=true), front clear → moveForward
# Expected : motorDirection=RIGHT, forward=true

# Case A: forward=true
power
start
expect mode NormalMode
expect motorDirection FRONT
obstacle 1 1
expect motorDirection RIGHT
obstacle 0 0
expect mode NormalMode
expect cleaner on
expect motor moving
expect motorForward true
expect motorDirection RIGHT

# Reset
power
power
start
expect motorDirection FRONT

# Case B: forward=false
obstacle 1 1
obstacle 1 0
expect motorForward false
expect motorDirection FRONT
obstacle 1 1
expect motorDirection RIGHT
obstacle 0 0
expect mode NormalMode
expect cleaner on
expect motor moving
expect motorForward true
expect motorDirection RIGHT
exit
