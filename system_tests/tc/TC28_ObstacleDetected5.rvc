# TC28 : ObstacleDetected5
# Precondition : NormalMode, motorDirection=FRONT, forward=false
# Action : backward mode, left clear
# Expected : turnLeft, motorDirection → LEFT, forward=true
power
start
expect mode NormalMode
expect motorDirection FRONT
obstacle 1 1
obstacle 1 0
expect motorForward false
expect motorDirection FRONT
obstacle 0 0
expect mode NormalMode
expect cleaner on
expect motor moving
expect motorForward true
expect motorDirection LEFT
exit
